<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required Permissions -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SudokuSolverApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_sudoku"
        android:label="Sudoku Solver"
        android:supportsRtl="true"
        android:theme="@style/Theme.SudokuSolver">

        <!-- Main Activity -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Manual Input Activity -->
        <activity
            android:name=".ui.ManualInputActivity"
            android:exported="false"
            android:label="Manual Puzzle Entry" />

        <activity
            android:name=".ui.OcrScanAreaActivity"
            android:exported="false"
            android:label="OCR Scan Area" />

        <!-- Accessibility Service - Core for screen capture & input -->
        <service
            android:name=".service.SudokuAccessibilityService"
            android:icon="@drawable/ic_sudoku"
            android:label="@string/accessibility_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Screen Capture Foreground Service -->
        <service
            android:name=".service.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- Floating Button Service -->
        <service
            android:name=".service.FloatingButtonService"
            android:exported="false" />
    </application>
</manifest>
